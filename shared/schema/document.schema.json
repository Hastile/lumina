      "additionalProperties": false,
      "properties": {
        "id": {
          "title": "Id",
          "type": "string"
        },
        "kind": {
          "enum": [
            "video",
            "audio"
          ],
          "title": "Kind",
          "type": "string"
        },
        "name": {
          "title": "Name",
          "type": "string"
        },
        "locked": {
          "default": false,
          "title": "Locked",
          "type": "boolean"
        },
        "sync_lock": {
          "default": true,
          "title": "Sync Lock",
          "type": "boolean"
        },
        "hidden": {
          "default": false,
          "description": "video: eye toggle off",
          "title": "Hidden",
          "type": "boolean"
        },
        "muted": {
          "default": false,
          "title": "Muted",
          "type": "boolean"
        },
        "solo": {
          "default": false,
          "title": "Solo",
          "type": "boolean"
        },
        "targeted": {
          "default": true,
          "title": "Targeted",
          "type": "boolean"
        },
        "clips": {
          "additionalProperties": {
            "$ref": "#/$defs/Clip"
          },
          "title": "Clips",
          "type": "object"
        }
      },
      "required": [
        "id",
        "kind",
        "name",
        "locked",
        "sync_lock",
        "hidden",
        "muted",
        "solo",
        "targeted",
        "clips"
      ],
      "title": "Track",
      "type": "object"
    },
    "VideoStream": {
      "additionalProperties": false,
      "properties": {
        "width": {
          "title": "Width",
          "type": "integer"
        },
        "height": {
          "title": "Height",
          "type": "integer"
        },
        "fps_num": {
          "title": "Fps Num",
          "type": "integer"
        },
        "fps_den": {
          "title": "Fps Den",
          "type": "integer"
        },
        "codec": {
          "default": "",
          "title": "Codec",
          "type": "string"
        },
        "pix_fmt": {
          "default": "",
          "title": "Pix Fmt",
          "type": "string"
        }
