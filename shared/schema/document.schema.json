      "type": "object"
    },
    "SequenceSettings": {
      "additionalProperties": false,
      "properties": {
        "width": {
          "default": 1920,
          "title": "Width",
          "type": "integer"
        },
        "height": {
          "default": 1080,
          "title": "Height",
          "type": "integer"
        },
        "fps_num": {
          "default": 30,
          "title": "Fps Num",
          "type": "integer"
        },
        "fps_den": {
          "default": 1,
          "title": "Fps Den",
          "type": "integer"
        },
        "sample_rate": {
          "default": 48000,
          "title": "Sample Rate",
          "type": "integer"
        }
      },
      "required": [
        "width",
        "height",
        "fps_num",
        "fps_den",
        "sample_rate"
      ],
      "title": "SequenceSettings",
      "type": "object"
    },
    "ShapeLayer": {
      "additionalProperties": false,
      "description": "A vector shape. Its path lives in layer pixels; ``anchor`` (layer pixels)\nlands on ``position`` (sequence pixels), then scale and rotation apply\naround it, like Premiere's per-layer transform.",
      "properties": {
        "id": {
          "title": "Id",
          "type": "string"
        },
        "type": {
          "const": "shape",
          "default": "shape",
          "title": "Type",
          "type": "string"
        },
        "shape": {
          "default": "rectangle",
          "enum": [
            "rectangle",
            "ellipse",
            "path"
          ],
          "title": "Shape",
          "type": "string"
        },
        "path": {
          "description": "vertices [x, y, in_x, in_y, out_x, out_y]; tangent handles are absolute points",
          "items": {
            "items": {
              "type": "number"
            },
            "type": "array"
          },
          "title": "Path",
          "type": "array"
        },
        "closed": {
          "default": true,
          "title": "Closed",
          "type": "boolean"
        },
        "fill": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": "#ffffff",
          "description": "null = no fill",
          "title": "Fill"
        },
        "stroke_color": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Stroke Color"
        },
        "stroke_width": {
          "default": 0.0,
          "title": "Stroke Width",
          "type": "number"
        },
        "position": {
          "description": "sequence pixels where the anchor lands",
          "items": {
            "type": "number"
