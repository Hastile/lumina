        },
        "thumbnail_path": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Thumbnail Path"
        },
        "waveform_path": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Waveform Path"
        },
        "in_point": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "source monitor In mark, ticks",
          "title": "In Point"
        },
        "out_point": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "source monitor Out mark, ticks",
          "title": "Out Point"
        }
      },
      "required": [
        "id",
        "name",
        "path",
        "bin_id",
        "kind",
        "duration",
        "video",
        "audio",
        "label",
        "proxy_path",
        "thumbnail_path",
        "waveform_path",
        "in_point",
        "out_point"
      ],
      "title": "MediaItem",
      "type": "object"
    },
    "Sequence": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "title": "Id",
          "type": "string"
        },
        "name": {
          "title": "Name",
          "type": "string"
        },
        "bin_id": {
          "title": "Bin Id",
          "type": "string"
        },
        "settings": {
          "$ref": "#/$defs/SequenceSettings"
        },
        "tracks": {
          "additionalProperties": {
            "$ref": "#/$defs/Track"
          },
          "title": "Tracks",
          "type": "object"
        },
        "video_tracks": {
          "description": "bottom (V1) to top",
          "items": {
            "type": "string"
          },
          "title": "Video Tracks",
          "type": "array"
        },
        "audio_tracks": {
          "description": "top (A1) to bottom",
          "items": {
            "type": "string"
          },
          "title": "Audio Tracks",
          "type": "array"
        },
        "markers": {
          "additionalProperties": {
            "$ref": "#/$defs/Marker"
          },
          "title": "Markers",
          "type": "object"
        },
        "playhead": {
          "default": 0,
          "title": "Playhead",
          "type": "integer"
        },
        "in_point": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "In Point"
        },
        "out_point": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Out Point"
        }
      },
      "required": [
        "id",
        "name",
        "bin_id",
        "settings",
        "tracks",
        "video_tracks",
        "audio_tracks",
        "markers",
        "playhead",
        "in_point",
        "out_point"
      ],
      "title": "Sequence",
      "type": "object"
