    "@vitejs/plugin-react": "^5.2.0",
    "electron": "^44.7.2",
    "electron-vite": "^5.0.0",
    "json-schema-to-typescript": "^16.0.0",
    "playwright": "^1.64.0",
    "typescript": "^5.9.3",
    "vite": "^7.3.7",
    "vitest": "^3.2.7"
  },
  "dependencies": {
    "dockview-react": "^8.5.1",
    "lucide-react": "^1.56.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "zustand": "^5.0.15"
