    "Motion": {
      "additionalProperties": false,
      "description": "Premiere's intrinsic Motion effect.",
      "properties": {
        "position": {
          "anyOf": [
            {
              "items": {
                "type": "number"
              },
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "sequence pixels [x, y]; null = frame center",
          "title": "Position"
        },
        "scale": {
          "default": 100.0,
          "title": "Scale",
          "type": "number"
        },
        "scale_width": {
          "default": 100.0,
          "description": "used when uniform is false",
          "title": "Scale Width",
          "type": "number"
        },
        "uniform": {
          "default": true,
          "title": "Uniform",
          "type": "boolean"
        },
        "rotation": {
          "default": 0.0,
          "description": "degrees, clockwise",
          "title": "Rotation",
          "type": "number"
        },
        "anchor": {
          "anyOf": [
            {
              "items": {
                "type": "number"
              },
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "source pixels [x, y]; null = source center",
          "title": "Anchor"
        },
        "crop_left": {
          "default": 0.0,
          "title": "Crop Left",
          "type": "number"
        },
        "crop_top": {
          "default": 0.0,
          "title": "Crop Top",
          "type": "number"
        },
        "crop_right": {
          "default": 0.0,
          "title": "Crop Right",
          "type": "number"
        },
        "crop_bottom": {
          "default": 0.0,
          "title": "Crop Bottom",
          "type": "number"
        }
      },
      "required": [
        "position",
        "scale",
        "scale_width",
        "uniform",
        "rotation",
        "anchor",
        "crop_left",
        "crop_top",
        "crop_right",
        "crop_bottom"
      ],
      "title": "Motion",
      "type": "object"
    },
