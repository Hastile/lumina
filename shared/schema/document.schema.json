{
  "$defs": {
    "AudioStream": {
      "additionalProperties": false,
      "properties": {
        "channels": {
          "title": "Channels",
          "type": "integer"
        },
        "sample_rate": {
          "title": "Sample Rate",
          "type": "integer"
        },
        "codec": {
          "default": "",
          "title": "Codec",
          "type": "string"
        }
      },
      "required": [
        "channels",
        "sample_rate",
        "codec"
      ],
      "title": "AudioStream",
      "type": "object"
    },
    "Bin": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "title": "Id",
          "type": "string"
        },
        "name": {
          "title": "Name",
          "type": "string"
        },
        "parent_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Parent Id"
        }
      },
      "required": [
        "id",
        "name",
        "parent_id"
      ],
      "title": "Bin",
      "type": "object"
    },
    "Clip": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "title": "Id",
          "type": "string"
        },
        "media_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "description": "null for graphics",
          "title": "Media Id"
        },
        "name": {
          "title": "Name",
          "type": "string"
        },
        "start": {
          "description": "timeline start, ticks (inclusive)",
          "title": "Start",
          "type": "integer"
        },
        "end": {
          "description": "timeline end, ticks (exclusive)",
          "title": "End",
          "type": "integer"
        },
        "source_in": {
          "description": "source time at `start`, ticks",
          "title": "Source In",
          "type": "integer"
        },
        "speed": {
          "default": 1.0,
          "title": "Speed",
          "type": "number"
        },
        "enabled": {
          "default": true,
          "title": "Enabled",
          "type": "boolean"
        },
        "link_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "clips sharing a link_id move/trim together",
          "title": "Link Id"
        },
        "label": {
          "default": "iris",
          "enum": [
            "violet",
            "iris",
            "caribbean",
            "lavender",
            "cerulean",
            "forest",
            "rose",
            "mango",
            "purple",
            "blue",
            "teal",
            "magenta",
            "tan",
            "green",
            "brown",
            "yellow"
          ],
          "title": "Label",
          "type": "string"
        },
        "opacity": {
          "default": 100.0,
          "title": "Opacity",
          "type": "number"
        },
        "volume_db": {
          "default": 0.0,
          "title": "Volume Db",
          "type": "number"
        },
        "motion": {
          "$ref": "#/$defs/Motion"
        },
        "keyframes": {
          "additionalProperties": {
            "items": {
              "$ref": "#/$defs/Keyframe"
            },
            "type": "array"
          },
          "propertyNames": {
            "enum": [
              "position",
              "scale",
              "scale_width",
              "rotation",
              "anchor",
              "crop_left",
              "crop_top",
              "crop_right",
              "crop_bottom",
              "opacity",
              "volume_db"
            ]
          },
          "title": "Keyframes",
          "type": "object"
        },
        "graphic": {
          "anyOf": [
            {
              "$ref": "#/$defs/Graphic"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "effects": {
          "items": {
            "$ref": "#/$defs/Effect"
          },
          "title": "Effects",
          "type": "array"
        }
      },
      "required": [
        "id",
        "media_id",
        "name",
        "start",
        "end",
        "source_in",
        "speed",
        "enabled",
        "link_id",
        "label",
        "opacity",
        "volume_db",
        "motion",
        "keyframes",
        "graphic",
        "effects"
      ],
      "title": "Clip",
      "type": "object"
    },
    "Effect": {
      "additionalProperties": false,
      "description": "A standard effect, applied in order before the intrinsic Motion/Opacity\n(Premiere's render order). Params and keyframes are keyed by the names in\n``lumina.effects.EFFECTS``; keyframe times are source ticks, like Motion's.",
      "properties": {
        "id": {
          "title": "Id",
          "type": "string"
        },
        "type": {
          "enum": [
            "transform",
            "gaussian_blur"
          ],
          "title": "Type",
          "type": "string"
        },
        "enabled": {
          "default": true,
          "title": "Enabled",
          "type": "boolean"
        },
        "params": {
          "additionalProperties": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "boolean"
              },
              {
                "items": {
                  "type": "number"
                },
                "type": "array"
              }
            ]
          },
          "title": "Params",
          "type": "object"
        },
        "keyframes": {
          "additionalProperties": {
            "items": {
              "$ref": "#/$defs/Keyframe"
            },
            "type": "array"
          },
          "title": "Keyframes",
          "type": "object"
        }
      },
      "required": [
        "id",
        "type",
        "enabled",
        "params",
        "keyframes"
      ],
      "title": "Effect",
      "type": "object"
    },
    "Graphic": {
      "additionalProperties": false,
      "properties": {
        "layers": {
          "items": {
            "$ref": "#/$defs/TextLayer"
          },
          "title": "Layers",
          "type": "array"
        },
        "source": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "origin, e.g. 'mogrt:Title' for imported Premiere graphics",
          "title": "Source"
        }
      },
      "required": [
        "layers",
        "source"
      ],
      "title": "Graphic",
      "type": "object"
    },
    "Keyframe": {
      "additionalProperties": false,
      "properties": {
        "t": {
          "description": "source time in ticks (Premiere convention: keyframes follow the content when trimmed)",
          "title": "T",
          "type": "integer"
        },
        "v": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "items": {
                "type": "number"
              },
              "type": "array"
            }
          ],
          "title": "V"
        },
        "interp": {
          "default": "linear",
          "enum": [
            "linear",
            "ease",
            "hold"
          ],
          "title": "Interp",
          "type": "string"
        }
      },
      "required": [
        "t",
        "v",
        "interp"
      ],
      "title": "Keyframe",
      "type": "object"
    },
    "Marker": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "title": "Id",
          "type": "string"
        },
        "start": {
          "title": "Start",
          "type": "integer"
        },
        "duration": {
          "default": 0,
          "title": "Duration",
          "type": "integer"
        },
        "name": {
          "default": "",
          "title": "Name",
          "type": "string"
        },
        "comment": {
          "default": "",
          "title": "Comment",
          "type": "string"
        },
        "color": {
          "default": "green",
