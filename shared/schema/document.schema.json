{
  "$defs": {
    "AudioStream": {
      "additionalProperties": false,
      "properties": {
        "channels": {
          "title": "Channels",
          "type": "integer"
        },
        "sample_rate": {
          "title": "Sample Rate",
          "type": "integer"
        },
        "codec": {
          "default": "",
          "title": "Codec",
          "type": "string"
        }
      },
      "required": [
        "channels",
        "sample_rate",
        "codec"
      ],
      "title": "AudioStream",
      "type": "object"
    },
    "Bin": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "title": "Id",
          "type": "string"
        },
        "name": {
          "title": "Name",
          "type": "string"
        },
        "parent_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Parent Id"
        }
      },
      "required": [
        "id",
        "name",
        "parent_id"
      ],
      "title": "Bin",
      "type": "object"
    },
    "Clip": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "title": "Id",
          "type": "string"
        },
        "media_id": {
          "title": "Media Id",
          "type": "string"
        },
        "name": {
          "title": "Name",
          "type": "string"
        },
        "start": {
          "description": "timeline start, ticks (inclusive)",
          "title": "Start",
          "type": "integer"
        },
        "end": {
          "description": "timeline end, ticks (exclusive)",
          "title": "End",
          "type": "integer"
        },
        "source_in": {
          "description": "source time at `start`, ticks",
          "title": "Source In",
          "type": "integer"
        },
        "speed": {
          "default": 1.0,
          "title": "Speed",
          "type": "number"
        },
        "enabled": {
          "default": true,
          "title": "Enabled",
          "type": "boolean"
        },
        "link_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "clips sharing a link_id move/trim together",
          "title": "Link Id"
        },
        "label": {
          "default": "iris",
          "enum": [
            "violet",
            "iris",
            "caribbean",
            "lavender",
            "cerulean",
            "forest",
            "rose",
            "mango",
            "purple",
            "blue",
            "teal",
            "magenta",
            "tan",
            "green",
            "brown",
            "yellow"
          ],
          "title": "Label",
          "type": "string"
        },
        "opacity": {
          "default": 100.0,
          "title": "Opacity",
          "type": "number"
        },
        "volume_db": {
          "default": 0.0,
          "title": "Volume Db",
          "type": "number"
        }
      },
      "required": [
        "id",
        "media_id",
        "name",
        "start",
        "end",
        "source_in",
        "speed",
        "enabled",
        "link_id",
        "label",
        "opacity",
        "volume_db"
      ],
      "title": "Clip",
      "type": "object"
    },
    "Marker": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "title": "Id",
          "type": "string"
        },
        "start": {
          "title": "Start",
          "type": "integer"
        },
        "duration": {
          "default": 0,
          "title": "Duration",
          "type": "integer"
        },
        "name": {
          "default": "",
          "title": "Name",
          "type": "string"
        },
        "comment": {
          "default": "",
          "title": "Comment",
          "type": "string"
        },
        "color": {
          "default": "green",
          "enum": [
            "green",
            "red",
            "purple",
            "orange",
            "yellow",
            "white",
            "blue",
            "cyan"
          ],
          "title": "Color",
          "type": "string"
        }
      },
      "required": [
        "id",
        "start",
        "duration",
        "name",
        "comment",
        "color"
      ],
      "title": "Marker",
      "type": "object"
    },
    "MediaItem": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "title": "Id",
          "type": "string"
        },
