    "Transition": {
      "additionalProperties": false,
      "description": "A transition at an edit point. Its position follows the clips: the cut is\n``clip_a``'s end (or ``clip_b``'s start for a single-sided one).",
      "properties": {
        "id": {
          "title": "Id",
          "type": "string"
        },
        "type": {
          "default": "cross_dissolve",
          "enum": [
            "cross_dissolve",
            "dip_to_black",
            "dip_to_white",
            "constant_power"
          ],
          "title": "Type",
          "type": "string"
        },
        "clip_a": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "outgoing clip (ends at the cut)",
          "title": "Clip A"
        },
        "clip_b": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "incoming clip (starts at the cut)",
          "title": "Clip B"
        },
        "duration": {
          "description": "ticks",
          "title": "Duration",
          "type": "integer"
        },
        "alignment": {
          "default": "center",
          "description": "center at cut / start at cut (over clip_b) / end at cut (over clip_a)",
          "enum": [
            "center",
            "start",
            "end"
          ],
          "title": "Alignment",
          "type": "string"
        }
      },
      "required": [
        "id",
        "type",
        "clip_a",
        "clip_b",
        "duration",
        "alignment"
      ],
      "title": "Transition",
      "type": "object"
    },
