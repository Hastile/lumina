{
  "$defs": {
    "AudioStream": {
      "additionalProperties": false,
      "properties": {
        "channels": {
          "title": "Channels",
          "type": "integer"
        },
        "sample_rate": {
          "title": "Sample Rate",
          "type": "integer"
        },
        "codec": {
          "default": "",
          "title": "Codec",
          "type": "string"
        }
      },
      "required": [
        "channels",
        "sample_rate",
        "codec"
      ],
      "title": "AudioStream",
      "type": "object"
    },
    "AutoMatchState": {
      "additionalProperties": false,
      "properties": {
        "target": {
          "description": "LUFS it was matched to",
          "title": "Target",
          "type": "number"
        },
        "lufs": {
          "description": "loudness measured before the match",
          "title": "Lufs",
          "type": "number"
        },
        "gain_db": {
          "description": "the Audio Gain Auto-Match set",
          "title": "Gain Db",
          "type": "number"
        },
        "previous_gain_db": {
          "description": "the Audio Gain before it (Reset restores it)",
          "title": "Previous Gain Db",
          "type": "number"
        }
      },
      "required": [
        "target",
        "lufs",
        "gain_db",
        "previous_gain_db"
      ],
      "title": "AutoMatchState",
      "type": "object"
    },
    "Bin": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "title": "Id",
          "type": "string"
        },
        "name": {
          "title": "Name",
          "type": "string"
        },
        "parent_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Parent Id"
        }
      },
      "required": [
        "id",
        "name",
        "parent_id"
      ],
      "title": "Bin",
      "type": "object"
    },
    "Clip": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "title": "Id",
          "type": "string"
        },
        "media_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "description": "null for graphics and nested sequences",
          "title": "Media Id"
        },
        "sequence_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "nested sequence (Premiere's Nest): the clip shows that sequence, and source_in is a time in it",
          "title": "Sequence Id"
        },
        "name": {
          "title": "Name",
          "type": "string"
        },
        "start": {
          "description": "timeline start, ticks (inclusive)",
          "title": "Start",
          "type": "integer"
        },
        "end": {
          "description": "timeline end, ticks (exclusive)",
          "title": "End",
          "type": "integer"
        },
        "source_in": {
          "description": "source time at `start`, ticks",
          "title": "Source In",
          "type": "integer"
        },
        "speed": {
          "default": 1.0,
          "title": "Speed",
          "type": "number"
        },
        "enabled": {
          "default": true,
          "title": "Enabled",
          "type": "boolean"
        },
        "link_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "clips sharing a link_id move/trim together",
          "title": "Link Id"
        },
        "label": {
          "default": "iris",
          "enum": [
            "violet",
            "iris",
            "caribbean",
            "lavender",
            "cerulean",
            "forest",
            "rose",
            "mango",
            "purple",
            "blue",
            "teal",
            "magenta",
            "tan",
            "green",
            "brown",
            "yellow"
          ],
          "title": "Label",
          "type": "string"
        },
        "opacity": {
          "default": 100.0,
          "title": "Opacity",
          "type": "number"
        },
        "volume_db": {
          "default": 0.0,
          "title": "Volume Db",
          "type": "number"
        },
        "gain_db": {
          "default": 0.0,
          "description": "Audio Gain (Premiere's G dialog), applied before Volume",
          "title": "Gain Db",
          "type": "number"
        },
        "audio_tag": {
          "anyOf": [
            {
              "enum": [
                "dialogue",
                "music",
                "sfx",
                "ambience"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Essential Sound audio type",
          "title": "Audio Tag"
        },
        "muted": {
          "default": false,
          "description": "Essential Sound Mute: the clip is silent (it stays enabled)",
          "title": "Muted",
          "type": "boolean"
        },
        "auto_match": {
          "anyOf": [
            {
              "$ref": "#/$defs/AutoMatchState"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "the last Loudness Auto-Match (for its status and Reset)"
        },
        "motion": {
          "$ref": "#/$defs/Motion"
        },
        "keyframes": {
          "additionalProperties": {
            "items": {
              "$ref": "#/$defs/Keyframe"
            },
            "type": "array"
          },
          "propertyNames": {
            "enum": [
              "position",
              "scale",
              "scale_width",
              "rotation",
              "anchor",
              "crop_left",
              "crop_top",
              "crop_right",
              "crop_bottom",
              "opacity",
              "volume_db"
            ]
          },
          "title": "Keyframes",
          "type": "object"
        },
        "graphic": {
          "anyOf": [
            {
              "$ref": "#/$defs/Graphic"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "effects": {
          "items": {
            "$ref": "#/$defs/Effect"
          },
          "title": "Effects",
          "type": "array"
        }
      },
      "required": [
        "id",
        "media_id",
        "sequence_id",
        "name",
        "start",
        "end",
        "source_in",
        "speed",
        "enabled",
        "link_id",
        "label",
        "opacity",
        "volume_db",
        "gain_db",
        "audio_tag",
        "muted",
        "auto_match",
        "motion",
        "keyframes",
        "graphic",
        "effects"
      ],
      "title": "Clip",
      "type": "object"
    },
    "Effect": {
      "additionalProperties": false,
      "description": "A standard effect, applied in order before the intrinsic Motion/Opacity\n(Premiere's render order). Params and keyframes are keyed by the names in\n``lumina.effects.EFFECTS``; keyframe times are source ticks, like Motion's.",
      "properties": {
        "id": {
          "title": "Id",
          "type": "string"
        },
        "type": {
          "enum": [
            "transform",
            "gaussian_blur",
            "lumetri",
            "parametric_eq",
            "compressor",
            "hard_limiter"
          ],
          "title": "Type",
          "type": "string"
        },
        "enabled": {
          "default": true,
          "title": "Enabled",
          "type": "boolean"
        },
        "params": {
          "additionalProperties": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "boolean"
              },
              {
                "items": {
                  "type": "number"
                },
                "type": "array"
              }
            ]
          },
          "title": "Params",
          "type": "object"
        },
        "keyframes": {
          "additionalProperties": {
            "items": {
              "$ref": "#/$defs/Keyframe"
            },
            "type": "array"
          },
          "title": "Keyframes",
          "type": "object"
        }
      },
      "required": [
        "id",
        "type",
        "enabled",
        "params",
        "keyframes"
      ],
      "title": "Effect",
      "type": "object"
    },
    "Graphic": {
      "additionalProperties": false,
      "properties": {
        "layers": {
          "description": "bottom to top",
          "items": {
            "discriminator": {
              "mapping": {
                "shape": "#/$defs/ShapeLayer",
                "text": "#/$defs/TextLayer"
              },
              "propertyName": "type"
            },
            "oneOf": [
              {
                "$ref": "#/$defs/TextLayer"
              },
              {
                "$ref": "#/$defs/ShapeLayer"
              }
            ]
          },
          "title": "Layers",
          "type": "array"
        },
        "source": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "origin, e.g. 'mogrt:Title' for imported Premiere graphics",
          "title": "Source"
        }
      },
      "required": [
        "layers",
        "source"
      ],
      "title": "Graphic",
      "type": "object"
    },
    "Keyframe": {
      "additionalProperties": false,
      "description": "Temporal interpolation follows After Effects/Premiere: each side of a\nkeyframe is linear, hold, or a Bezier handle given as [speed, influence]\n(value units per second of source time, fraction 0-1 of the segment).\n\"ease\" is a Bezier with Premiere's Easy Ease handles (speed 0, 33 %).\n\"auto_bezier\" computes its handles from the neighbours (a smooth curve\nthrough the keyframe); \"continuous_bezier\" keeps both sides at one speed.\nPoint values may also carry spatial tangents (value units, relative to\nthe keyframe) shaping the motion path.",
      "properties": {
        "t": {
          "description": "source time in ticks (Premiere convention: keyframes follow the content when trimmed)",
          "title": "T",
          "type": "integer"
        },
        "v": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "items": {
                "type": "number"
              },
              "type": "array"
            }
          ],
          "title": "V"
        },
        "interp": {
          "default": "linear",
          "enum": [
            "linear",
            "ease",
            "hold",
            "bezier",
            "auto_bezier",
            "continuous_bezier"
          ],
          "title": "Interp",
          "type": "string"
        },
        "ease_in": {
          "anyOf": [
            {
              "items": {
                "type": "number"
              },
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "[speed, influence] of the incoming Bezier handle",
          "title": "Ease In"
        },
        "ease_out": {
          "anyOf": [
            {
              "items": {
                "type": "number"
              },
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "[speed, influence] of the outgoing Bezier handle",
          "title": "Ease Out"
        },
        "tangent_in": {
          "anyOf": [
            {
              "items": {
                "type": "number"
              },
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "spatial in-tangent for point values",
          "title": "Tangent In"
        },
        "tangent_out": {
          "anyOf": [
            {
              "items": {
                "type": "number"
              },
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "spatial out-tangent for point values",
          "title": "Tangent Out"
        }
      },
      "required": [
        "t",
        "v",
        "interp",
        "ease_in",
        "ease_out",
        "tangent_in",
        "tangent_out"
      ],
      "title": "Keyframe",
      "type": "object"
    },
    "Marker": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "title": "Id",
          "type": "string"
        },
        "start": {
          "title": "Start",
          "type": "integer"
        },
        "duration": {
          "default": 0,
          "title": "Duration",
          "type": "integer"
        },
        "name": {
          "default": "",
          "title": "Name",
          "type": "string"
        },
        "comment": {
          "default": "",
          "title": "Comment",
          "type": "string"
        },
        "color": {
          "default": "green",
          "enum": [
            "green",
            "red",
            "purple",
            "orange",
            "yellow",
            "white",
            "blue",
            "cyan"
          ],
          "title": "Color",
          "type": "string"
        }
      },
      "required": [
        "id",
        "start",
        "duration",
        "name",
        "comment",
        "color"
      ],
      "title": "Marker",
      "type": "object"
    },
    "MediaItem": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "title": "Id",
          "type": "string"
        },
        "name": {
          "title": "Name",
          "type": "string"
        },
        "path": {
          "title": "Path",
          "type": "string"
        },
        "bin_id": {
          "title": "Bin Id",
          "type": "string"
        },
        "kind": {
          "enum": [
            "video",
            "audio",
            "image"
          ],
          "title": "Kind",
          "type": "string"
        },
        "duration": {
          "description": "ticks; 0 for stills",
          "title": "Duration",
          "type": "integer"
        },
        "video": {
          "anyOf": [
            {
              "$ref": "#/$defs/VideoStream"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "audio": {
          "anyOf": [
            {
              "$ref": "#/$defs/AudioStream"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "label": {
          "default": "iris",
          "enum": [
            "violet",
            "iris",
            "caribbean",
            "lavender",
            "cerulean",
            "forest",
            "rose",
            "mango",
            "purple",
            "blue",
            "teal",
            "magenta",
            "tan",
            "green",
            "brown",
            "yellow"
          ],
          "title": "Label",
          "type": "string"
        },
        "proxy_path": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Proxy Path"
        },
        "thumbnail_path": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Thumbnail Path"
        },
        "waveform_path": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Waveform Path"
        },
        "filmstrip_path": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "timeline thumbnails: JSON {image, interval, count, width, height}",
          "title": "Filmstrip Path"
        },
        "in_point": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "source monitor In mark, ticks",
          "title": "In Point"
        },
        "out_point": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "source monitor Out mark, ticks",
          "title": "Out Point"
        }
      },
      "required": [
        "id",
        "name",
        "path",
        "bin_id",
        "kind",
        "duration",
        "video",
        "audio",
        "label",
        "proxy_path",
        "thumbnail_path",
        "waveform_path",
        "filmstrip_path",
        "in_point",
        "out_point"
      ],
      "title": "MediaItem",
      "type": "object"
    },
    "Motion": {
      "additionalProperties": false,
      "description": "Premiere's intrinsic Motion effect.",
      "properties": {
        "position": {
          "anyOf": [
            {
              "items": {
                "type": "number"
              },
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "sequence pixels [x, y]; null = frame center",
          "title": "Position"
        },
        "scale": {
          "default": 100.0,
          "title": "Scale",
          "type": "number"
        },
        "scale_width": {
          "default": 100.0,
          "description": "used when uniform is false",
          "title": "Scale Width",
          "type": "number"
        },
        "uniform": {
          "default": true,
          "title": "Uniform",
          "type": "boolean"
        },
        "rotation": {
          "default": 0.0,
          "description": "degrees, clockwise",
          "title": "Rotation",
          "type": "number"
        },
        "anchor": {
          "anyOf": [
            {
              "items": {
                "type": "number"
              },
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "source pixels [x, y]; null = source center",
          "title": "Anchor"
        },
        "crop_left": {
          "default": 0.0,
          "title": "Crop Left",
          "type": "number"
        },
        "crop_top": {
          "default": 0.0,
          "title": "Crop Top",
          "type": "number"
        },
        "crop_right": {
          "default": 0.0,
          "title": "Crop Right",
          "type": "number"
        },
        "crop_bottom": {
          "default": 0.0,
          "title": "Crop Bottom",
          "type": "number"
        }
      },
      "required": [
        "position",
        "scale",
        "scale_width",
        "uniform",
        "rotation",
        "anchor",
        "crop_left",
        "crop_top",
        "crop_right",
        "crop_bottom"
      ],
      "title": "Motion",
      "type": "object"
    },
    "Sequence": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "title": "Id",
          "type": "string"
        },
        "name": {
          "title": "Name",
          "type": "string"
        },
        "bin_id": {
          "title": "Bin Id",
          "type": "string"
        },
        "settings": {
          "$ref": "#/$defs/SequenceSettings"
        },
        "tracks": {
          "additionalProperties": {
            "$ref": "#/$defs/Track"
          },
          "title": "Tracks",
          "type": "object"
        },
        "video_tracks": {
          "description": "bottom (V1) to top",
          "items": {
            "type": "string"
          },
          "title": "Video Tracks",
          "type": "array"
        },
        "audio_tracks": {
          "description": "top (A1) to bottom",
          "items": {
            "type": "string"
          },
          "title": "Audio Tracks",
          "type": "array"
        },
        "markers": {
          "additionalProperties": {
            "$ref": "#/$defs/Marker"
          },
          "title": "Markers",
          "type": "object"
        },
        "playhead": {
          "default": 0,
          "title": "Playhead",
          "type": "integer"
        },
        "in_point": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "In Point"
        },
        "out_point": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Out Point"
        },
        "master_volume_db": {
          "default": 0.0,
          "description": "Audio Track Mixer's Mix fader",
          "title": "Master Volume Db",
          "type": "number"
        }
      },
      "required": [
        "id",
        "name",
        "bin_id",
        "settings",
        "tracks",
        "video_tracks",
        "audio_tracks",
        "markers",
        "playhead",
        "in_point",
        "out_point",
        "master_volume_db"
      ],
