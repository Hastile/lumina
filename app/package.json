{
  "name": "lumina-app",
  "version": "0.1.0",
  "private": true,
  "description": "Lumina video editor (Electron GUI)",
  "main": "out/main/index.js",
  "type": "module",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
