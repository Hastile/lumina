          "type": "integer"
        },
        "height": {
          "title": "Height",
          "type": "integer"
        },
        "fps_num": {
          "title": "Fps Num",
          "type": "integer"
        },
        "fps_den": {
          "title": "Fps Den",
          "type": "integer"
        },
        "codec": {
          "default": "",
          "title": "Codec",
          "type": "string"
        },
        "pix_fmt": {
          "default": "",
          "title": "Pix Fmt",
          "type": "string"
