    "id": {
      "title": "Id",
      "type": "string"
    },
    "name": {
      "title": "Name",
      "type": "string"
    },
    "root_bin_id": {
      "title": "Root Bin Id",
      "type": "string"
    },
    "bins": {
      "additionalProperties": {
        "$ref": "#/$defs/Bin"
      },
      "title": "Bins",
      "type": "object"
    },
    "media": {
      "additionalProperties": {
        "$ref": "#/$defs/MediaItem"
      },
      "title": "Media",
      "type": "object"
    },
    "sequences": {
      "additionalProperties": {
        "$ref": "#/$defs/Sequence"
      },
      "title": "Sequences",
      "type": "object"
    },
    "active_sequence_id": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Active Sequence Id"
    }
  },
  "required": [
    "schema_version",
    "id",
    "name",
    "root_bin_id",
    "bins",
    "media",
    "sequences",
    "active_sequence_id"
  ],
  "title": "Project",
  "type": "object"
}