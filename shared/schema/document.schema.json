          "type": "integer"
        },
        "height": {
          "default": 1080,
          "title": "Height",
          "type": "integer"
        },
        "fps_num": {
          "default": 30,
          "title": "Fps Num",
          "type": "integer"
        },
        "fps_den": {
          "default": 1,
          "title": "Fps Den",
          "type": "integer"
        },
        "sample_rate": {
          "default": 48000,
          "title": "Sample Rate",
          "type": "integer"
        }
      },
      "required": [
        "width",
        "height",
        "fps_num",
        "fps_den",
        "sample_rate"
      ],
      "title": "SequenceSettings",
      "type": "object"
    },
