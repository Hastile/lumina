  {
    "name": "sequence.create",
    "description": "Create an empty sequence (File > New > Sequence).",
    "undoable": true,
    "params": {
      "$defs": {
        "SequenceSettingsParams": {
          "additionalProperties": false,
          "properties": {
            "width": {
              "default": 1920,
              "title": "Width",
              "type": "integer"
            },
            "height": {
              "default": 1080,
              "title": "Height",
              "type": "integer"
            },
            "fps_num": {
              "default": 30,
              "title": "Fps Num",
              "type": "integer"
            },
            "fps_den": {
              "default": 1,
              "title": "Fps Den",
              "type": "integer"
            },
            "sample_rate": {
              "default": 48000,
              "title": "Sample Rate",
              "type": "integer"
            }
          },
          "title": "SequenceSettingsParams",
          "type": "object"
        }
      },
      "additionalProperties": false,
      "properties": {
        "name": {
          "default": "Sequence 01",
          "title": "Name",
          "type": "string"
        },
        "bin_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Bin Id"
        },
        "settings": {
          "$ref": "#/$defs/SequenceSettingsParams"
        },
        "video_tracks": {
          "default": 3,
          "maximum": 99,
          "minimum": 1,
          "title": "Video Tracks",
          "type": "integer"
        },
        "audio_tracks": {
          "default": 3,
          "maximum": 99,
          "minimum": 1,
          "title": "Audio Tracks",
          "type": "integer"
        },
        "activate": {
          "default": true,
          "title": "Activate",
          "type": "boolean"
        }
      },
      "title": "CreateSequence",
      "type": "object"
    }
  },
