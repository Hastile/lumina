        "label": {
          "default": "iris",
          "enum": [
            "violet",
            "iris",
            "caribbean",
            "lavender",
            "cerulean",
            "forest",
            "rose",
            "mango",
            "purple",
            "blue",
            "teal",
            "magenta",
            "tan",
            "green",
            "brown",
            "yellow"
          ],
          "title": "Label",
          "type": "string"
        },
        "proxy_path": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
